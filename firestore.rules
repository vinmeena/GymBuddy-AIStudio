rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Match clients collection
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Match users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Match trainers collection
    match /trainers/{trainerId} {
      allow read, write: if true;
    }

    // Match jobs collection
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Match assessments collection
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Match chats collection
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // Match offers collection
    match /offers/{offerId} {
      allow read, write: if true;
    }

    // Match payments / invoices collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Match notifications collection
    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
